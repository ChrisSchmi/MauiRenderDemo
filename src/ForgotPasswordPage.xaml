<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiRenderDemo"
             x:Class="MauiRenderDemo.ForgotPasswordPage"
            Title="Passwort vergessen">

    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

        <GraphicsView x:Name="PlasmaView"
                      HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand">
            <GraphicsView.Drawable>
                <local:PlasmaDrawable x:Name="Drawable" />
            </GraphicsView.Drawable>
        </GraphicsView>

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320"
                Padding="25"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="#E0E0E0"
                BackgroundColor="#E6FFFFFF">

            <StackLayout Spacing="15">

                <Label Text="Passwort vergessen" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#1A1A1A" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,5"/>

                <Label Text="Geben Sie Ihre E-Mail-Adresse ein. Wir senden Ihnen einen Link, um Ihr Passwort zurückzusetzen."
                       FontSize="14"
                       TextColor="#666666"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,10" />

                <Entry x:Name="ResetEmailEntry"
                       Placeholder="E-Mail-Adresse"
                       Keyboard="Email"
                       TextColor="#1A1A1A"
                       PlaceholderColor="#757575" />

                <Button x:Name="SendLinkButton"
                        Text="Link senden"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        Margin="0,10,0,0" />

                <BoxView HeightRequest="1" 
                         Color="#E0E0E0" 
                         Margin="0,10,0,5" />

                <Button x:Name="BackToLoginButton"
                        Text="Zurück zum Login"
                        BackgroundColor="Transparent"
                        TextColor="#512BD4"
                        FontSize="14"
                        HeightRequest="40"
                        Padding="0" />

            </StackLayout>
        </Border>

    </Grid>
</ContentPage>