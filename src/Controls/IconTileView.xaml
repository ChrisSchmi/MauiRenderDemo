<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiRenderDemo.Controls.IconTileView"
             x:Name="Root">

    <!-- Wir geben dem ContentView direkt den GestureRecognizer -->
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTileTapped" />
    </ContentView.GestureRecognizers>

    <VerticalStackLayout Spacing="6"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">

        <Border x:Name="ShapeBorder"
                HeightRequest="{Binding Source={x:Reference Root}, Path=ShapeSize}"
                WidthRequest="{Binding Source={x:Reference Root}, Path=ShapeSize}"
                BackgroundColor="{Binding Source={x:Reference Root}, Path=ShapeColor}"
                Stroke="{Binding Source={x:Reference Root}, Path=BorderColor}"
                StrokeThickness="{Binding Source={x:Reference Root}, Path=BorderThickness}"
                HorizontalOptions="Center"
                Padding="0">

            <Border.StrokeShape>
                <RoundRectangle x:Name="ShapeGeometry" CornerRadius="32" />
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow x:Name="ShapeShadow"
                        Brush="Black"
                        Opacity="0.25"
                        Radius="8"
                        Offset="0,3" />
            </Border.Shadow>

            <Border.Behaviors>
                <toolkit:TouchBehavior
                HoveredBackgroundColor="#10000000"
                PressedBackgroundColor="#30000000"
                PressedOpacity="0.8" />
            </Border.Behaviors>

            <!-- WICHTIG: InputTransparent="True" verhindert, dass das Label den Klick "schluckt" -->
            <Label x:Name="IconLabel"
                   InputTransparent="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   LineBreakMode="NoWrap"
                   Text="{Binding Source={x:Reference Root}, Path=IconGlyph}"
                   FontFamily="{Binding Source={x:Reference Root}, Path=IconFontFamily}"
                   FontSize="{Binding Source={x:Reference Root}, Path=IconFontSize}"
                   TextColor="{Binding Source={x:Reference Root}, Path=IconColor}" />
        </Border>

        <!-- WICHTIG: Auch hier InputTransparent="True" -->
        <Label x:Name="CaptionLabel"
               InputTransparent="True"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Text="{Binding Source={x:Reference Root}, Path=CaptionText}"
               TextColor="{Binding Source={x:Reference Root}, Path=CaptionColor}"
               FontSize="{Binding Source={x:Reference Root}, Path=CaptionFontSize}"
               IsVisible="{Binding Source={x:Reference Root}, Path=HasCaption}" />

    </VerticalStackLayout>
</ContentView>