<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiRenderDemo"
             xmlns:controls="clr-namespace:MauiRenderDemo.Controls"
             x:Class="MauiRenderDemo.MainPage"
             x:Name="Main"
            Title="Login">

    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">

        <GraphicsView x:Name="PlasmaView"
                      IsVisible="true"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <local:PlasmaDrawable x:Name="Drawable" />
            </GraphicsView.Drawable>
        </GraphicsView>

        <GraphicsView
                x:Name="FadeView"
                HorizontalOptions="Fill" 
                VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <local:BackgroundImageDrawable
                    x:Name="FadedBackgroundDrawable"
                    VisibleImagePosition="Bottom"
                    ImageFile="{StaticResource DotNetBot}" />
            </GraphicsView.Drawable>
        </GraphicsView>


        <Border
            IsVisible="true"
            HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="320"
                Padding="25"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="#E0E0E0"
                BackgroundColor="#E6FFFFFF">
            <StackLayout Spacing="15">

                <Label Text="Willkommen" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#1A1A1A" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,10"/>

                <Entry x:Name="EmailEntry"
                       Placeholder="E-Mail-Adresse"
                       Keyboard="Email"
                       TextColor="#1A1A1A"
                       PlaceholderColor="#757575" />

                <Entry x:Name="PasswordEntry"
                       Placeholder="Passwort"
                       IsPassword="True"
                       TextColor="#1A1A1A"
                       PlaceholderColor="#757575" />

                <Button x:Name="LoginButton"
                        Text="Login"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        Margin="0,10,0,0" />

                <Button x:Name="CreateAccountButton"
                        Text="Account anlegen"
                        BackgroundColor="Transparent"
                        TextColor="#512BD4"
                        BorderColor="#512BD4"
                        BorderWidth="1"
                        CornerRadius="8" />

                <BoxView HeightRequest="1" 
                         Color="#E0E0E0" 
                         Margin="0,10,0,5" />

                <StackLayout Spacing="2">

                    <Button x:Name="ForgotPasswordButton"
                            Text="Passwort vergessen?"
                            BackgroundColor="Transparent"
                            Clicked="OnForgotPasswordClicked"
                            TextColor="#666666"
                            FontSize="12"
                            HeightRequest="30"
                            Padding="0" />

                    <Button x:Name="HelpButton"
                            Text="Hilfe"
                            BackgroundColor="Transparent"
                            TextColor="#666666"
                            FontSize="12"
                            HeightRequest="30"
                            Padding="0" />

                    <Button x:Name="TermsButton"
                            Text="AGB &amp; Datenschutz"
                            BackgroundColor="Transparent"
                            TextColor="#666666"
                            FontSize="12"
                            HeightRequest="30"
                            Padding="0" />

                </StackLayout>

            </StackLayout>
        </Border>

    

    <FlexLayout
        IsVisible="true"
        Wrap="Wrap"
        JustifyContent="SpaceEvenly"
        AlignItems="Center"
        Padding="24,1">

        <!-- 1) Wie im Bild: Kreis, Font-Awesome-Icon, mit Text, per Command steuerbar -->
        <controls:IconTileView ShapeType="Circle"
                                ShapeColor="#FFBA00"
                                ShapeSize="72"
                                IconGlyph="&#xf030;"
                                IconFontFamily="FASolid"
                                IconColor="White"
                                CaptionText="Vorschau"
                                CaptionColor="#FF0000"
                                ClickColor="#3000ff00"
                                Command="{Binding IconTileCommand, Source={x:Reference Main}}"
                                BorderColor="#0fbaf0"
                                BorderThickness="1"
                                Margin="12" />

        <!-- 2) Viereck mit abgerundeten Ecken, Emoji als Icon, kein Text -->
        <controls:IconTileView ShapeType="RoundedRectangle"
                                CaptionText=""
                                CornerRadius="18"
                                ShapeColor="#FF0043"
                                
                                ShapeSize="72"
                                IconGlyph="🐣"
                                IconFontSize="30"
                                Command="{Binding IconTileCommand, Source={x:Reference Main}}"
                                Margin="12" />

        <!-- 3) Scharfkantiges Viereck, andere Farbe, mit Text -->
        <controls:IconTileView ShapeType="Rectangle"
                                ShapeColor="#00cccc"
                                ShapeSize="72"
                                IconGlyph="&#xf07b;"
                                IconFontFamily="FASolid"
                                IconColor="#fbfa00"
                                ClickColor="#30ff00ff"
                                CaptionText="Ordner"
                                Command="{Binding IconTileCommand, Source={x:Reference Main}}"
                                Margin="12" />

    </FlexLayout>
    </Grid>


</ContentPage>
