<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:renderers="clr-namespace:MauiRenderDemo.Renderers"
             x:Class="MauiRenderDemo.FadingBackgroundPage"
             x:Name="FBGPage"
             Title="FadingBackgroundPage">
    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">
        <GraphicsView
                x:Name="FadeView"
                HorizontalOptions="Fill" 
                VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <renderers:BackgroundImageDrawable
                    x:Name="FadedBackgroundDrawable"
                    VisibleImagePosition="Bottom"
                    ImageFile="{StaticResource DotNetBot}" />
            </GraphicsView.Drawable>
        </GraphicsView>

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="300"
                HeightRequest="300"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="#E0E0E0"
                BackgroundColor="#E6FFFFFF">
            <Grid
            Margin="20,10"
            RowSpacing="5"
            RowDefinitions="1*,1*,1*,1*,1*">
                <Button Grid.Row="1" Text="Top" Command="{Binding SetBackgroundCommand, Source={x:Reference FBGPage}}" CommandParameter="top" />
                <Button Grid.Row="2" Text="Full" Command="{Binding SetBackgroundCommand, Source={x:Reference FBGPage}}" CommandParameter="full" />
                <Button Grid.Row="3" Text="Bottom" Command="{Binding SetBackgroundCommand, Source={x:Reference FBGPage}}" CommandParameter="bottom" />
            </Grid>
        </Border>

        
        
    </Grid>
</ContentPage>